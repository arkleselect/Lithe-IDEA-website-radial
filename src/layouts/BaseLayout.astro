---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  lang?: 'zh-CN' | 'en' | 'ja' | 'ko';
}

const { title = site.name, description = site.description, lang = 'en' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/assets/lithe-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05040a" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      const isMacOS = /Macintosh|Mac OS X/.test(navigator.userAgent) || navigator.platform.startsWith('Mac');
      if (isMacOS) {
        document.querySelectorAll<SVGElement>('[data-mac-icon]').forEach((icon) => {
          icon.classList.add('is-visible');
        });
      }

      const hero = document.querySelector<HTMLElement>('[data-hero]');
      const codeLayer = document.querySelector<HTMLElement>('[data-hero-code]');
      const preview = document.querySelector<HTMLElement>('[data-hero-preview]');
      const appSlot = document.querySelector<HTMLElement>('[data-hero-app]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (hero && !reducedMotion) {
        let frame = 0;
        const updateHeroDepth = () => {
          const rawProgress = Math.max(0, Math.min(1, -hero.getBoundingClientRect().top / Math.max(window.innerHeight * 0.72, 1)));
          const progress = rawProgress * rawProgress * (3 - 2 * rawProgress);
          hero.style.setProperty('--hero-scroll-progress', String(progress));
          hero.style.setProperty('--hero-glow-opacity', String(1 - progress));
          codeLayer?.style.setProperty('--code-scroll-y', `${progress * -22}px`);
          hero.style.setProperty('--glow-scroll-y', `${progress * -10}px`);
          preview?.style.setProperty('--preview-scroll-y', `${progress * -28}px`);
          appSlot?.style.setProperty('--app-scroll-y', `${(1 - progress) * 30}px`);
          frame = 0;
        };
        const requestHeroDepth = () => {
          if (!frame) frame = window.requestAnimationFrame(updateHeroDepth);
        };
        window.addEventListener('scroll', requestHeroDepth, { passive: true });
        requestHeroDepth();
      }
    </script>
  </body>
</html>
