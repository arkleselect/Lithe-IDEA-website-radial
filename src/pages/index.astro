---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroCode from '../components/HeroCode.astro';
import { features, site } from '../data/site';
---
<BaseLayout>
  <SiteNav />
  <main>
    <section class="hero hero-dark" data-hero aria-labelledby="hero-title">
      <div class="hero-background" aria-hidden="true"></div>
      <div class="hero-inner shell">
        <h1 id="hero-title">看见 AI 写下的每一行。</h1>
        <p class="hero-lede">Lithe 是为 AI 辅助开发保留 IDEA 核心习惯的原生 macOS IDE。</p>
        <div class="hero-actions hero-actions-centered"><a class="button button-primary" href={site.release} target="_blank" rel="noreferrer" data-download-button><svg class="download-platform-icon" data-mac-icon aria-hidden="true" width="24" height="24" viewBox="0 0 814 1000" fill="currentColor"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57.8-155.5-127.4c-58.8-82-106.5-209.3-106.5-330.5 0-194.6 126.4-298.1 250.8-298.1 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zM554.1 159.4c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 103.5-30.4 135.5-71.3z"></path></svg><span>免费下载</span></a><a class="button button-secondary" href={site.repository} target="_blank" rel="noreferrer">GitHub</a></div>
        <p class="hero-meta hero-meta-centered">适用于 Apple silicon 与 Intel · SwiftUI / AppKit · Swift 6.2+</p>
        <HeroCode />
        <div class="hero-visual hero-visual-centered" aria-label="Lithe 编辑器界面预览">
          <img src="/assets/lithe-hero-diff.png" width="2572" height="1404" alt="Lithe 中的项目树与 Swift 编辑器界面" fetchpriority="high" />
        </div>
      </div>
    </section>

    <section class="signal-band" id="product" aria-label="产品定位"><div class="shell signal-grid"><p class="section-kicker">A better loop after generation</p><p class="signal-statement">写完之后，真正重要的是理解、验证和决定。</p><p class="signal-detail">Lithe 将熟悉的 Java 工作流放回一个安静的原生桌面环境，让你不必在 AI 工具和项目之间来回切换。</p></div></section>

    <section class="feature-section shell" id="workflow" aria-labelledby="feature-title"><div class="section-heading"><p class="section-kicker">The core</p><h2 id="feature-title">把复杂的工作，留在视线里。</h2></div><div class="feature-list">{features.map((feature) => <article class="feature-row"><span class="feature-number">{feature.number}</span><h3>{feature.title}</h3><p>{feature.body}</p></article>)}</div></section>

    <section class="gallery-section shell" aria-labelledby="gallery-title"><div class="section-heading gallery-heading"><p class="section-kicker">Inside Lithe</p><h2 id="gallery-title">熟悉的界面，少一点负担。</h2><a class="text-link" href={site.repository} target="_blank" rel="noreferrer">探索仓库 <span aria-hidden="true">↗</span></a></div><div class="gallery-grid"><figure class="gallery-main"><img src="/assets/search-everywhere.png" width="1600" height="1000" loading="lazy" alt="Lithe 全局搜索界面" /><figcaption><span>Search everywhere</span><span>找到下一步。</span></figcaption></figure><figure class="gallery-side"><img src="/assets/ai-commit-message.png" width="1600" height="1000" loading="lazy" alt="Lithe AI Commit Message 界面" /><figcaption><span>AI commit message</span><span>决定如何交付。</span></figcaption></figure></div></section>

    <section class="download-section" id="download" aria-labelledby="download-title"><div class="shell download-inner"><div><p class="section-kicker">Start with the real thing</p><h2 id="download-title">让下一次改动<br />更容易被看见。</h2></div><div class="download-action"><p>macOS 13 或更高版本<br />支持 Apple silicon 与 Intel</p><a class="button button-primary" href={site.release} target="_blank" rel="noreferrer">下载 Lithe <span aria-hidden="true">↗</span></a></div></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
