---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HeroCode from '../../components/HeroCode.astro';
import { features, site } from '../../data/site';
---
<BaseLayout lang="en" title="Lithe" description="The IDEA-shaped core for AI-assisted development.">
  <SiteNav />
  <main>
    <section class="hero hero-dark" data-hero aria-labelledby="hero-title"><div class="hero-background" aria-hidden="true"></div><div class="hero-inner shell"><h1 id="hero-title">See every line AI writes.</h1><p class="hero-lede">Lithe is a native macOS IDE that keeps the IDEA-shaped core for AI-assisted development.</p><div class="hero-actions hero-actions-centered"><a class="button button-primary" href={site.release} target="_blank" rel="noreferrer" data-download-button><svg class="download-platform-icon" data-mac-icon aria-hidden="true" width="24" height="24" viewBox="0 0 814 1000" fill="currentColor"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57.8-155.5-127.4c-58.8-82-106.5-209.3-106.5-330.5 0-194.6 126.4-298.1 250.8-298.1 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zM554.1 159.4c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 103.5-30.4 135.5-71.3z"></path></svg><span>Download for Free</span></a><a class="button button-secondary" href={site.repository} target="_blank" rel="noreferrer">GitHub</a></div><p class="hero-meta hero-meta-centered">Apple silicon and Intel · SwiftUI / AppKit · Swift 6.2+</p><HeroCode /><div class="hero-visual hero-visual-centered" aria-label="Lithe editor interface preview"><img src="/assets/lithe-hero-diff.png" width="2572" height="1404" alt="Lithe project tree and Swift editor interface" fetchpriority="high" /></div></div></section>
    <div class="home-content-stage" aria-hidden="true"></div>
  </main>
  <SiteFooter />
</BaseLayout>
