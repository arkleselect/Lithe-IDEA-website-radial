---
interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;
const content = {
  en: {
    title: 'Built to keep you in control.',
    description: 'Native performance, reviewable AI, and familiar tools come together in one focused macOS workspace.',
    items: [
      ['Native foundation', 'SwiftUI and AppKit keep the workspace fast, focused, and at home on macOS.', ''],
      ['See every change', 'Generated edits remain visible and contextual before they become part of your codebase.', '/assets/lithe-hero-diff.png'],
      ['Keep structure in reach', 'Move through large project trees without losing the file or task in front of you.', '/assets/lithe-hero-project.png'],
      ['Stay focused in code', 'A restrained editor surface keeps syntax, files, and active work easy to read.', '/assets/lithe-hero-editor.png'],
      ['Tools where you expect', 'Search, Git, changes, and the terminal stay close without crowding the editor.', '/assets/lithe-hero-diff.png'],
    ],
  },
  zh: {
    title: '从始至终，控制权都在你手中。',
    description: '原生性能、可审查的 AI 与熟悉的工具，共同构成一个专注的 macOS 开发空间。',
    items: [
      ['原生基础', 'SwiftUI 与 AppKit 让工作空间在 macOS 上保持轻快、专注且自然。', ''],
      ['看见每一处修改', '生成的修改始终保持可见并附带上下文，再由你决定是否进入代码库。', '/assets/lithe-hero-diff.png'],
      ['项目结构触手可及', '在大型目录树中移动，同时始终掌握当前文件和正在处理的任务。', '/assets/lithe-hero-project.png'],
      ['专注于代码本身', '克制的编辑界面让语法、文件和当前工作始终清晰易读。', '/assets/lithe-hero-editor.png'],
      ['工具都在熟悉的位置', '搜索、Git、变更和终端随手可用，同时不会挤占编辑空间。', '/assets/lithe-hero-diff.png'],
    ],
  },
} as const;

const sectionContent = content[lang] ?? content.en;
const headingId = `benefits-title-${lang}`;
---

<section class="benefits-section" aria-labelledby={headingId}>
  <header class="benefits-heading">
    <h2 id={headingId}>{sectionContent.title}</h2>
    <p class="benefits-description">{sectionContent.description}</p>
  </header>
  <div class="benefits-grid">
    {sectionContent.items.map(([title, description, image], index) => (
      <article class={`benefit-item benefit-item-${index + 1}`}>
        <div class="benefit-graphic" aria-hidden="true">
          {image && <img src={image} alt="" loading="lazy" />}
        </div>
        <div class="benefit-copy">
          <h3>{title}</h3>
          <p>{description}</p>
        </div>
      </article>
    ))}
  </div>
</section>
