---
import { site } from '../data/site';
const pathname = Astro.url.pathname;
const locale = pathname.startsWith('/zh') ? 'zh' : pathname.startsWith('/ja') ? 'ja' : pathname.startsWith('/ko') ? 'ko' : 'en';
const copy = {
  en: { home: '/', contact: 'Contact', meta: 'Native macOS IDE · Apache-2.0' },
  zh: { home: '/zh/', contact: '联系团队', meta: '原生 macOS IDE · Apache-2.0' },
  ja: { home: '/ja/', contact: 'お問い合わせ', meta: 'ネイティブ macOS IDE · Apache-2.0' },
  ko: { home: '/ko/', contact: '문의하기', meta: '네이티브 macOS IDE · Apache-2.0' },
}[locale];
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand" href={copy.home}><img src="/assets/lithe-icon.png" width="24" height="24" alt="" /><span>Lithe</span></a>
      <p class="footer-note">A familiar IDE core with a lighter footprint.</p>
    </div>
    <div class="footer-links">
      <a href={site.repository} target="_blank" rel="noreferrer">GitHub ↗</a>
      <a href={site.release} target="_blank" rel="noreferrer">Releases ↗</a>
      <a href="mailto:hello@lithe.dev">{copy.contact}</a>
    </div>
    <p class="footer-meta">{copy.meta}</p>
  </div>
</footer>
