---
interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;
const copy = {
  en: { eyebrow: 'START WITH THE REAL THING', title: ['Make your next', 'change easier to see.'], requirements: ['macOS 13 or later', 'Apple silicon and Intel'], button: 'Download Lithe' },
  zh: { eyebrow: 'START WITH THE REAL THING', title: ['让下一次改动', '更容易被看见。'], requirements: ['macOS 13 或更高版本', '支持 Apple silicon 与 Intel'], button: '下载 Lithe' },
}[lang];
---

<section class="download-section" id="download" aria-labelledby={`download-title-${lang}`}>
  <div class="shell download-inner">
    <div><p class="section-kicker">{copy.eyebrow}</p><h2 id={`download-title-${lang}`}>{copy.title[0]}<br />{copy.title[1]}</h2></div>
    <div class="download-action"><p>{copy.requirements[0]}<br />{copy.requirements[1]}</p><a class="button button-primary" href="https://github.com/1lck/Lithe-IDEA/releases/latest" target="_blank" rel="noreferrer">{copy.button} <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
