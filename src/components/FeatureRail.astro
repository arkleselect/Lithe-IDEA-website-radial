---
interface Props { lang?: 'en' | 'zh'; }
const { lang = 'en' } = Astro.props;
const copy = {
  en: { eyebrow: 'THE WORKSPACE', title: 'Everything you need, close at hand.', items: [['Code', 'Navigate, search, and edit with clarity.'], ['Run', 'Start the right project with the right tool.'], ['Debug', 'Keep context while you trace behavior.'], ['Review', 'See what changed before it ships.'], ['Terminal', 'Use the command line without leaving your flow.']] },
  zh: { eyebrow: '工作区', title: '需要的一切，都在手边。', items: [['代码', '清晰地导航、搜索和编辑。'], ['运行', '用合适的工具启动正确的项目。'], ['调试', '追踪行为时保留完整上下文。'], ['审查', '在发布前看见所有改动。'], ['终端', '无需离开工作流即可使用命令行。']] },
}[lang];
---
<section class="feature-rail" id="workflow" aria-labelledby={`feature-title-${lang}`}><div class="shell"><h2 id={`feature-title-${lang}`}>{copy.title}</h2><nav class="feature-rail-list" aria-label={copy.eyebrow}>{copy.items.map(([title, body]) => <a href="#workflow"><strong>{title}</strong><span>{body}</span><i aria-hidden="true">↗</i></a>)}</nav></div></section>
