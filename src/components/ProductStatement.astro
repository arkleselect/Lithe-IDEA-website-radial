---
interface Props { lang?: 'en' | 'zh'; }
const { lang = 'en' } = Astro.props;
const copy = {
  en: { title: 'An IDE that keeps AI-assisted development understandable.', items: [['01', 'See every change', 'Generated edits stay visible, contextual, and easy to review.'], ['02', 'Navigate with confidence', 'A familiar project core keeps large workspaces within reach.'], ['03', 'Stay native', 'SwiftUI and AppKit keep the experience light, fast, and at home on macOS.']] },
  zh: { title: '让 AI 辅助开发始终清晰可见。', items: [['01', '看见每次改动', '生成的修改保持可见、有上下文，并且容易审查。'], ['02', '自信地导航', '熟悉的项目核心让大型工作区依然清晰可控。'], ['03', '保持原生体验', 'SwiftUI 与 AppKit 让 macOS 体验轻盈、快速而自然。']] },
}[lang];
---
<section class="product-statement" id="product" aria-labelledby={`statement-title-${lang}`}>
  <div class="shell"><h2 id={`statement-title-${lang}`}>{copy.title}</h2><div class="statement-grid">{copy.items.map(([, title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}</div></div>
</section>
