---
interface Props { lang?: 'en' | 'zh'; }
const { lang = 'en' } = Astro.props;
const copy = {
  en: {
    eyebrow: 'FAQ',
    title: 'A few things worth knowing.',
    intro: 'Short answers about Lithe, compatibility, and getting started.',
    items: [
      ['What is Lithe?', 'Lithe is a lightweight, native macOS IDE built around a familiar IDEA-shaped workflow for AI-assisted development.'],
      ['Which Macs are supported?', 'Lithe supports Apple silicon and Intel Macs running macOS 13 or later.'],
      ['Is Lithe open source?', 'Yes. Lithe is developed in the open under the Apache-2.0 license. You can inspect the source, report issues, and contribute on GitHub.'],
      ['Which languages can the website display?', 'The website is available in English and Simplified Chinese. English is shown by default.'],
      ['Where can I report a problem or request a feature?', 'Open an issue in the Lithe GitHub repository with the steps to reproduce, your macOS version, and any useful screenshots or logs.'],
    ],
  },
  zh: {
    eyebrow: '常见问题',
    title: '一些你可能想了解的事情。',
    intro: '关于 Lithe、兼容性与开始使用的简要回答。',
    items: [
      ['Lithe 是什么？', 'Lithe 是一款轻量的原生 macOS IDE，保留熟悉的 IDEA 式工作流，并面向 AI 辅助开发。'],
      ['支持哪些 Mac？', 'Lithe 支持运行 macOS 13 或更高版本的 Apple silicon 与 Intel Mac。'],
      ['Lithe 是开源的吗？', '是的。Lithe 使用 Apache-2.0 许可证开源开发，你可以在 GitHub 查看源码、反馈问题并参与贡献。'],
      ['官网支持哪些语言？', '官网支持英文和简体中文，默认显示英文。'],
      ['在哪里反馈问题或提出功能建议？', '请在 Lithe 的 GitHub 仓库创建 Issue，并附上复现步骤、macOS 版本以及有帮助的截图或日志。'],
    ],
  },
}[lang];
---

<section class="faq-section" aria-labelledby={`faq-title-${lang}`}>
  <div class="shell faq-shell">
    <header class="faq-centered-heading">
      <h2 id={`faq-title-${lang}`}>{copy.eyebrow}</h2>
    </header>
    <div class="faq-list" data-faq-list>
      {copy.items.map(([question, answer]) => (
        <details class="faq-item">
          <summary><span>{question}</span><span class="faq-toggle" aria-hidden="true"></span></summary>
          <div class="faq-answer"><p>{answer}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq-list]').forEach((list) => {
    list.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach((item) => {
      const summary = item.querySelector<HTMLElement>('summary');
      const answer = item.querySelector<HTMLElement>('.faq-answer');
      if (!summary || !answer) return;

      summary.addEventListener('click', (event) => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        event.preventDefault();
        answer.getAnimations().forEach((animation) => animation.cancel());

        if (!item.open) {
          item.classList.add('is-expanded');
          item.open = true;
          answer.animate(
            [{ height: '0px', opacity: 0 }, { height: `${answer.scrollHeight}px`, opacity: 1 }],
            { duration: 260, easing: 'cubic-bezier(.22, 1, .36, 1)' },
          ).finished.then(() => { answer.style.height = 'auto'; });
          return;
        }

        item.classList.remove('is-expanded');
        const animation = answer.animate(
          [{ height: `${answer.scrollHeight}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
          { duration: 210, easing: 'cubic-bezier(.4, 0, 1, 1)' },
        );
        animation.finished.then(() => {
          item.open = false;
          answer.style.height = '';
        });
      });
    });
  });
</script>
